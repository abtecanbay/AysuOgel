@model PagedResult<ContactMessage>
@using AysuOgel.Business.Models
@using AysuOgel.Web.Helpers
@{
    ViewData["Title"] = "Mesajlar";
    var f = ViewData["Filter"] as MessageFilter ?? new MessageFilter();
    var hasFilter = f.Subject.HasValue
        || !string.IsNullOrWhiteSpace(f.Name)
        || !string.IsNullOrWhiteSpace(f.Phone)
        || f.AppointmentFrom.HasValue
        || f.AppointmentTo.HasValue;
}

<form method="get" asp-action="Index">
    @if (!string.IsNullOrEmpty(f.Sort))
    {
        <input type="hidden" name="Sort" value="@f.Sort" />
        <input type="hidden" name="PageSize" value="@f.PageSize" />
    }
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <h1 class="h3 mb-0">Mesajlar</h1>
        <select name="Subject" class="form-select form-select-sm w-auto" aria-label="Konuya göre filtrele"
                onchange="this.form.submit()">
            <option value="">Tüm konular</option>
            @foreach (var s in Enum.GetValues<ContactSubject>())
            {
                <option value="@((int)s)" selected="@(f.Subject == s)">@s.DisplayName()</option>
            }
        </select>
    </div>

    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label small mb-1" for="fName">Ad Soyad</label>
            <input id="fName" name="Name" value="@f.Name" class="form-control form-control-sm" autocomplete="off" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="fPhone">Telefon</label>
            <input id="fPhone" name="Phone" value="@f.Phone" class="form-control form-control-sm" autocomplete="off" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="fFrom">Randevu: başlangıç</label>
            <input id="fFrom" type="date" name="AppointmentFrom" value="@f.AppointmentFrom?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="fTo">Randevu: bitiş</label>
            <input id="fTo" type="date" name="AppointmentTo" value="@f.AppointmentTo?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-sm btn-primary">Filtrele</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Temizle</a>
        </div>
    </div>
</form>

<p class="text-muted small">@Model.TotalCount kayıt@(hasFilter ? " (filtreli)" : "")</p>

<table class="table align-middle">
    <thead>
        <tr>
            <th aria-sort="@(f.Descending ? "descending" : "ascending")">
                <partial name="_SortLink" model="@(new SortLinkModel("Tarih", f.Descending))" />
            </th>
            <th>Ad Soyad</th>
            <th>Konu</th>
            <th>Telefon</th>
            <th>Randevu</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model.Items)
        {
            @* Üyeden gelen seans değişikliği talebi gözden kaçmasın diye açık sarı vurgulanır. *@
            var memberRequest = m.Subject == ContactSubject.SeansDegisikligi;
            <tr class="@(m.Status == MessageStatus.Yeni ? "fw-bold" : "") @(memberRequest ? "table-warning" : "")">
                <td>@m.CreatedAt.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@m.FirstName @m.LastName</td>
                <td>
                    @m.Subject.DisplayName()
                    @if (memberRequest)
                    {
                        <span class="badge text-bg-warning fw-semibold ms-1">Üye talebi</span>
                    }
                </td>
                <td>@m.Phone</td>
                <td>@(m.RequestedAppointmentAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                <td><partial name="_MessageStatusBadge" model="m.Status" /></td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Görüntüle</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pager" model="Model" />

@if (Model.TotalCount == 0)
{
    <p class="text-muted">@(hasFilter ? "Filtreye uyan mesaj yok." : "Henüz mesaj yok.")</p>
}