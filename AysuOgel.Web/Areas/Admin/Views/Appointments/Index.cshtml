@model List<Appointment>
@using System.Globalization
@using AysuOgel.Business.Models
@using AysuOgel.Web.Helpers
@{
    ViewData["Title"] = "Randevular";
    var f = ViewData["Filter"] as AppointmentFilter ?? new AppointmentFilter();
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var hasFilter = f.Status.HasValue
        || !string.IsNullOrWhiteSpace(f.Name)
        || !string.IsNullOrWhiteSpace(f.Phone)
        || f.From.HasValue
        || f.To.HasValue
        || f.All;
}

<form method="get" asp-action="Index">
    @if (!string.IsNullOrEmpty(f.Sort))
    {
        <input type="hidden" name="Sort" value="@f.Sort" />
    }
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <h1 class="h3 mb-0">Randevu Talepleri</h1>
        <select name="Status" class="form-select form-select-sm w-auto" aria-label="Duruma göre filtrele"
                onchange="this.form.submit()">
            <option value="">Tüm durumlar</option>
            @foreach (var s in Enum.GetValues<AppointmentStatus>())
            {
                <option value="@((int)s)" selected="@(f.Status == s)">@s.DisplayName()</option>
            }
        </select>
    </div>

    <div class="row g-2 align-items-end mb-2">
        <div class="col-md-3">
            <label class="form-label small mb-1" for="fName">Ad Soyad</label>
            <input id="fName" name="Name" value="@f.Name" class="form-control form-control-sm" autocomplete="off" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="fPhone">Telefon</label>
            <input id="fPhone" name="Phone" value="@f.Phone" class="form-control form-control-sm" autocomplete="off" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="fFrom">Randevu: başlangıç</label>
            <input id="fFrom" type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="fTo">Randevu: bitiş</label>
            <input id="fTo" type="date" name="To" value="@f.To?.ToString("yyyy-MM-dd")"
                   class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-sm btn-primary">Filtrele</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Temizle</a>
        </div>
    </div>

    <div class="form-check mb-3">
        <input id="fAll" class="form-check-input" type="checkbox" name="All" value="true" checked="@f.All" />
        <label class="form-check-label small" for="fAll">Geçmiş randevuları da göster</label>
    </div>
</form>

<p class="text-muted small">
    @Model.Count kayıt@(hasFilter ? " (filtreli)" : "").
    Tarih aralığı seçilmezse bugünden itibaren olan randevular listelenir.
</p>

@if (TempData["AppointmentError"] is string err)
{
    <div class="alert alert-danger" role="alert">@err</div>
}

<table class="table align-middle">
    <thead>
        <tr>
            <th aria-sort="@(f.Descending ? "descending" : "ascending")">
                <partial name="_SortLink" model="@(new SortLinkModel("Randevu", f.Descending))" />
            </th>
            <th>Ad Soyad</th>
            <th>Telefon</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.SlotStart.ToString("dd.MM.yyyy HH:mm") <span class="text-muted small">@a.SlotStart.ToString("dddd", tr)</span></td>
                <td>
                    <a asp-controller="Messages" asp-action="Details" asp-route-id="@a.ContactMessageId">
                        @a.ContactMessage.FirstName @a.ContactMessage.LastName
                    </a>
                </td>
                <td>@a.ContactMessage.Phone</td>
                <td>
                    @switch (a.Status)
                    {
                        case AppointmentStatus.Beklemede:
                            <span class="badge bg-warning text-dark">@a.Status.DisplayName()</span>
                            break;
                        case AppointmentStatus.Onaylandi:
                            <span class="badge bg-success">@a.Status.DisplayName()</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@a.Status.DisplayName()</span>
                            break;
                    }
                </td>
                <td class="text-end">
                    @if (a.Status == AppointmentStatus.Beklemede)
                    {
                        <form asp-action="SetStatus" asp-route-id="@a.Id" method="post" class="d-inline">
                            <input type="hidden" name="status" value="@((int)AppointmentStatus.Onaylandi)" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button class="btn btn-sm btn-success">Onayla</button>
                        </form>
                    }
                    @if (a.Status != AppointmentStatus.IptalEdildi)
                    {
                        <form asp-action="SetStatus" asp-route-id="@a.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Randevu iptal edilsin mi? Saat tekrar müsait olur.');">
                            <input type="hidden" name="status" value="@((int)AppointmentStatus.IptalEdildi)" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button class="btn btn-sm btn-outline-danger">İptal Et</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="SetStatus" asp-route-id="@a.Id" method="post" class="d-inline">
                            <input type="hidden" name="status" value="@((int)AppointmentStatus.Beklemede)" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button class="btn btn-sm btn-outline-secondary">Yeniden aç</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">@(hasFilter ? "Filtreye uyan randevu yok." : "Randevu talebi yok.")</p>
}