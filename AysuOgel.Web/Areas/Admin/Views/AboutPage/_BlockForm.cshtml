@model AboutBlock
@{
    var removeImages = ViewData["RemoveImages"] as int[] ?? [];
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="150" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" maxlength="80" placeholder="Boş bırakılırsa başlıktan üretilir" />
        <span asp-validation-for="Slug" class="text-danger"></span>
        <div class="form-text">Sayfa içi bağlantı: <code>/hakkimizda#post-@(string.IsNullOrEmpty(Model.Slug) ? "slug" : Model.Slug)</code></div>
    </div>
</div>

<div class="mt-3">
    <label asp-for="Text" class="form-label"></label>
    <textarea asp-for="Text" class="form-control" rows="6" maxlength="3000"></textarea>
    <span asp-validation-for="Text" class="text-danger"></span>
    <div class="form-text">Satır sonları sitede korunur. En fazla 3000 karakter.</div>
</div>

<div class="row g-3 mt-1 align-items-end">
    <div class="col-md-4">
        <label asp-for="Layout" class="form-label"></label>
        <select asp-for="Layout" asp-items="Html.GetEnumSelectList<AboutBlockLayout>()" class="form-select"></select>
        <span asp-validation-for="Layout" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <div class="form-check mb-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
</div>

<div class="admin-image-upload-panel mt-4">
    <label class="form-label fw-semibold" for="imageFiles">Görseller</label>
    <input id="imageFiles" name="imageFiles" type="file" class="form-control" multiple
           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
    <div class="form-text">
        JPG, PNG veya WEBP · her biri en fazla 5 MB · tek seferde en fazla 10 görsel.
        <strong>Görsel solda / sağda</strong> yerleşiminde sıradaki ilk görsel, <strong>Galeri</strong>'de tümü gösterilir.
        Görsel yoksa sitede yer tutucu görünür.
    </div>
    @Html.ValidationMessage("ImageFiles", null, new { @class = "text-danger small d-block mt-2" })

    @if (Model.Images.Count > 0)
    {
        <div class="row g-3 mt-1">
            @for (var i = 0; i < Model.Images.Count; i++)
            {
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <img src="@Url.ImageUrl(Model.Images[i].Url)" class="card-img-top admin-image-preview" alt="@Model.Images[i].Alt"
                             style="aspect-ratio: 4 / 3; object-fit: cover;" loading="lazy" />
                        <div class="card-body p-3">
                            <input type="hidden" asp-for="Images[i].Id" />
                            <input type="hidden" asp-for="Images[i].Url" />
                            <div class="mb-2">
                                <label asp-for="Images[i].Alt" class="form-label small mb-1"></label>
                                <input asp-for="Images[i].Alt" class="form-control form-control-sm" maxlength="200" placeholder="Boşsa blok başlığı kullanılır" />
                                <span asp-validation-for="Images[i].Alt" class="text-danger small"></span>
                            </div>
                            <div class="mb-2">
                                <label asp-for="Images[i].Caption" class="form-label small mb-1"></label>
                                <input asp-for="Images[i].Caption" class="form-control form-control-sm" maxlength="300" placeholder="Galeride görselin altında gösterilir" />
                                <span asp-validation-for="Images[i].Caption" class="text-danger small"></span>
                            </div>
                            <div class="d-flex align-items-end justify-content-between gap-2">
                                <div style="max-width: 6rem;">
                                    <label asp-for="Images[i].DisplayOrder" class="form-label small mb-1"></label>
                                    <input asp-for="Images[i].DisplayOrder" class="form-control form-control-sm" type="number" />
                                </div>
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" name="removeImages" value="@i" id="removeImage@(i)"
                                           checked="@removeImages.Contains(i)" />
                                    <label class="form-check-label small text-danger" for="removeImage@(i)">Kaldır</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
