@inject AysuOgel.Business.Abstract.ISiteSettingsService SiteSettingsService
@inject AysuOgel.Business.Abstract.IAdminPageService AdminPageService
@{
    var site = await SiteSettingsService.GetCachedAsync();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    // Menü, AdminPages tablosundan ve oturumdaki yöneticinin yetkilerinden oluşturulur.
    List<AdminPage> menuPages = isAuthenticated ? await AdminPageService.GetAccessibleAsync(User.GetAdminUserId()) : [];
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetim | @site.SiteTitle</title>
    @if (!string.IsNullOrEmpty(site.FaviconUrl))
    {
        <link rel="icon" href="@Url.ImageUrl(site.FaviconUrl)" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <nav class="navbar navbar-expand-lg navbar-dark admin-navbar">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand fw-bold" asp-area="Admin" asp-controller="Account" asp-action="Start">
                <span class="admin-brand-mark">A</span> Aysu Öğel <span class="fw-normal opacity-75">/ Yönetim</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
                        aria-controls="adminNav" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="adminNav">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        @foreach (var adminPage in menuPages)
                        {
                            var isActive = string.Equals(adminPage.Controller, currentController, StringComparison.OrdinalIgnoreCase) ||
                                           (adminPage.RelatedControllers ?? "").Split(',', StringSplitOptions.TrimEntries)
                                               .Contains(currentController, StringComparer.OrdinalIgnoreCase);
                            <li class="nav-item">
                                <a class="nav-link @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)"
                                   asp-area="Admin" asp-controller="@adminPage.Controller" asp-action="Index">@adminPage.Title</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3 py-2">
                        <span class="small text-white-50 d-none d-xl-inline">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</span>
                        <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">Siteyi Gör ↗</a>
                        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button class="btn btn-sm btn-admin-logout">Çıkış Yap</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </nav>

    <main class="container-fluid admin-main px-3 px-lg-4 py-4">
        @RenderBody()
    </main>

    <footer class="admin-footer px-3 px-lg-4 py-3">
        <div class="container-fluid d-flex justify-content-between flex-wrap gap-2">
            <span>Aysu Öğel Sağlıklı Yaşam</span>
            <span>Yönetim Paneli · @DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>