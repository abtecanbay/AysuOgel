@model MemberFormViewModel
@{
    ViewData["Title"] = "Üyeyi Düzenle";
}

<div class="admin-page-heading">
    <div><p class="admin-eyebrow mb-1">ÜYE YÖNETİMİ</p><h1 class="h3 mb-0">@ViewData["Title"]</h1></div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">← Üye detayına dön</a>
</div>
<div class="card admin-form-card"><div class="card-body p-4">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary px-4">Değişiklikleri kaydet</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">İptal</a></div>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
