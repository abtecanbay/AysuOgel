@model MemberPackageFormViewModel
@{
    var mp = (MemberPackage)ViewData["MemberPackage"]!;
    ViewData["Title"] = "Paket Tarihlerini Düzenle";
}

<div class="admin-page-heading">
    <div>
        <p class="admin-eyebrow mb-1">@mp.Member.FirstName @mp.Member.LastName</p>
        <h1 class="h3 mb-0">@mp.Package.Name</h1>
    </div>
    <a asp-action="Details" asp-route-id="@mp.MemberId" asp-fragment="package-@mp.Id" class="btn btn-outline-secondary">← Üye detayına dön</a>
</div>
<div class="card admin-form-card"><div class="card-body p-4">
    <form asp-action="EditPackage" asp-route-id="@mp.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>
        <div class="form-text mt-2">
            Bitiş tarihi zorunlu değildir. Paketin son seansı "Yapıldı" olarak işaretlendiğinde bitiş tarihi o seansın tarihiyle güncellenir.
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary px-4">Kaydet</button>
            <a asp-action="Details" asp-route-id="@mp.MemberId" asp-fragment="package-@mp.Id" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
