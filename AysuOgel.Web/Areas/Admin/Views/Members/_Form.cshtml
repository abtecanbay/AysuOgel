@model MemberFormViewModel
@{
    var packages = ViewData["Packages"] as List<Package> ?? [];
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6 text-muted mb-3">Üye bilgileri</h2>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autocomplete="off" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" autocomplete="off" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" autocomplete="off" placeholder="05xx xxx xx xx" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="form-text mt-2">
            @(Model.IsNew
                ? "Üye, seanslarını sorgulamak için bu e-posta ve şifreyle giriş yapacak."
                : "Şifreyi değiştirmek istemiyorsanız şifre alanlarını boş bırakın.")
        </div>
    </div>

    @if (Model.IsNew)
    {
        <div class="col-lg-6">
            <h2 class="h6 text-muted mb-3">Satın aldığı paket</h2>
            <div class="mb-3">
                <label asp-for="PackageId" class="form-label"></label>
                <select asp-for="PackageId" class="form-select" id="memberPackageSelect">
                    <option value="">Paket seçin</option>
                    @foreach (var p in packages)
                    {
                        <option value="@p.Id" data-validity-days="@p.ValidityDays" selected="@(Model.PackageId == p.Id)">
                            @p.Name · @p.SessionCount seans · @p.Price.ToLira()
                        </option>
                    }
                </select>
                <span asp-validation-for="PackageId" class="text-danger"></span>
                @if (packages.Count == 0)
                {
                    <div class="form-text text-danger">
                        Satışta paket yok. Önce <a asp-controller="Campaigns" asp-action="Index" asp-route-section="packages">Kampanyalar › Paketler</a> bölümünden paket ekleyin.
                    </div>
                }
            </div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control" id="memberStartDate" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control" id="memberEndDate" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-text mt-2">
                Bitiş tarihi zorunlu değildir; süreli paketlerde otomatik önerilir.
                Son seans "Yapıldı" olarak işaretlendiğinde o seansın tarihiyle güncellenir.
            </div>
        </div>
    }
</div>
