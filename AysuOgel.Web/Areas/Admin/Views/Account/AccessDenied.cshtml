@model List<AdminPage>
@{
    ViewData["Title"] = "Erişim Yetkisi Yok";
}

<div class="admin-login-wrap">
    <div class="card admin-login-card">
        <div class="admin-login-brand">
            <span class="admin-brand-mark">!</span>
            <div>
                <h1 class="h4 mb-1">Bu sayfaya erişiminiz yok</h1>
                <p class="text-muted mb-0">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</p>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <p class="text-muted mb-4">Hesabınıza henüz hiçbir yönetim sayfası atanmamış. Yetki için ana yöneticiyle iletişime geçin.</p>
        }
        else
        {
            <p class="text-muted mb-3">Hesabınızla erişebileceğiniz sayfalar:</p>
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var adminPage in Model)
                {
                    <a asp-area="Admin" asp-controller="@adminPage.Controller" asp-action="Index" class="btn btn-sm btn-outline-secondary">@adminPage.Title</a>
                }
            </div>
        }

        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button class="btn btn-outline-danger btn-sm">Çıkış Yap</button>
        </form>
    </div>
</div>
