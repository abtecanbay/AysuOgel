@model SiteSettings
<div class="card admin-form-card"><div class="card-body p-4">
    <form asp-action="Settings" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="LogoUrl" />
        <input type="hidden" asp-for="FaviconUrl" />

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="SiteTitle" class="form-label"></label>
                <input asp-for="SiteTitle" class="form-control" maxlength="150" />
                <span asp-validation-for="SiteTitle" class="text-danger"></span>
                <div class="form-text">Tarayıcı sekmesinde sayfa adının yanında görünür. Örn: “Hizmetler - @Model.SiteTitle”</div>
            </div>
            <div class="col-md-5">
                <label asp-for="BrandName" class="form-label"></label>
                <input asp-for="BrandName" class="form-control" maxlength="60" />
                <span asp-validation-for="BrandName" class="text-danger"></span>
                <div class="form-text">Menüde logonun yanında ve sayfa altında görünen kısa ad.</div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label" for="logoFile">Logo</label>
                <div class="d-flex align-items-center gap-3 mb-2">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Url.ImageUrl(Model.LogoUrl)" alt="Mevcut logo" class="border rounded-3 p-1 bg-white" style="height:56px;max-width:180px;object-fit:contain" />
                    }
                    else
                    {
                        <span class="admin-table-thumb admin-table-thumb-empty" aria-hidden="true">▢</span>
                        <span class="small text-muted">Logo yüklenmemiş, varsayılan simge kullanılıyor.</span>
                    }
                </div>
                <input type="file" id="logoFile" name="logoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span class="text-danger">@Html.ValidationMessage("LogoFile")</span>
                <div class="form-text">JPG, PNG veya WEBP · en fazla 5 MB · şeffaf arka planlı PNG önerilir.</div>
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="removeLogo" value="true" id="removeLogo" />
                        <label class="form-check-label" for="removeLogo">Logoyu kaldır (varsayılana dön)</label>
                    </div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" for="faviconFile">Favicon</label>
                <div class="d-flex align-items-center gap-3 mb-2">
                    @if (!string.IsNullOrEmpty(Model.FaviconUrl))
                    {
                        <img src="@Url.ImageUrl(Model.FaviconUrl)" alt="Mevcut favicon" class="border rounded-2 p-1 bg-white" width="40" height="40" style="object-fit:contain" />
                    }
                    else
                    {
                        <span class="admin-table-thumb admin-table-thumb-empty" aria-hidden="true">▢</span>
                        <span class="small text-muted">Favicon yüklenmemiş.</span>
                    }
                </div>
                <input type="file" id="faviconFile" name="faviconFile" class="form-control" accept=".ico,.png,.jpg,.jpeg,.webp" />
                <span class="text-danger">@Html.ValidationMessage("FaviconFile")</span>
                <div class="form-text">Tarayıcı sekmesindeki küçük simge. ICO veya kare PNG (örn. 64×64) önerilir.</div>
                @if (!string.IsNullOrEmpty(Model.FaviconUrl))
                {
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="removeFavicon" value="true" id="removeFavicon" />
                        <label class="form-check-label" for="removeFavicon">Favicon'u kaldır</label>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary px-4">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div></div>
