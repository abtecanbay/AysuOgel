@model SiteManagementViewModel
@{
    ViewData["Title"] = "Sayfa Yönetimi";
    var activeSection = Context.Request.Query["section"].ToString();
    var adminsExpanded = activeSection == "admins" && ViewData.ModelState.IsValid;
    var settingsExpanded = !adminsExpanded;
    var adminCount = Model.Admins.Count + (string.IsNullOrEmpty(Model.SystemAdminUsername) ? 0 : 1);
}

<div class="admin-page-heading">
    <div>
        <p class="admin-eyebrow mb-1">SİTE AYARLARI</p>
        <h1 class="h3 mb-1">Sayfa Yönetimi</h1>
        <p class="text-muted mb-0">Site başlığı, logo, favicon ve yönetim paneline erişebilecek yöneticileri yönetin.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener" class="btn btn-outline-secondary">Siteyi Gör ↗</a>
        <a asp-action="CreateAdmin" class="btn btn-primary">+ Yeni Yönetici</a>
    </div>
</div>

@if (TempData["SiteSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["SiteError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="accordion admin-campaigns-accordion" id="siteAdminAccordion">
    <div class="accordion-item admin-table-card mb-3">
        <h2 class="accordion-header" id="siteSettingsHeading">
            <button class="accordion-button @(settingsExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                    data-bs-target="#siteSettingsPanel" aria-expanded="@(settingsExpanded ? "true" : "false")" aria-controls="siteSettingsPanel">
                <span>
                    <span class="d-block fw-semibold">1. Genel Ayarlar</span>
                    <span class="d-block small text-muted fw-normal">Site başlığı, marka adı, logo ve favicon</span>
                </span>
            </button>
        </h2>
        <div id="siteSettingsPanel" class="accordion-collapse collapse @(settingsExpanded ? "show" : "")"
             aria-labelledby="siteSettingsHeading" data-bs-parent="#siteAdminAccordion">
            <div class="accordion-body">
                <partial name="_SettingsForm" model="Model.Settings" />
            </div>
        </div>
    </div>

    <div class="accordion-item admin-table-card">
        <h2 class="accordion-header" id="siteAdminsHeading">
            <button class="accordion-button @(adminsExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                    data-bs-target="#siteAdminsPanel" aria-expanded="@(adminsExpanded ? "true" : "false")" aria-controls="siteAdminsPanel">
                <span>
                    <span class="d-block fw-semibold">2. Yöneticiler</span>
                    <span class="d-block small text-muted fw-normal">@adminCount hesap · yönetim paneline giriş yapabilen kullanıcılar</span>
                </span>
            </button>
        </h2>
        <div id="siteAdminsPanel" class="accordion-collapse collapse @(adminsExpanded ? "show" : "")"
             aria-labelledby="siteAdminsHeading" data-bs-parent="#siteAdminAccordion">
            <div class="accordion-body">
                <partial name="_AdminList" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
