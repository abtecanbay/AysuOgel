@model CampaignPageSettings
<div class="card admin-form-card"><div class="card-body p-4">
    <form asp-action="PageSettings" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="IntroTitle" class="form-label"></label>
            <input asp-for="IntroTitle" class="form-control" />
            <span asp-validation-for="IntroTitle" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IntroText" class="form-label"></label>
            <textarea asp-for="IntroText" class="form-control" rows="3"></textarea>
            <span asp-validation-for="IntroText" class="text-danger"></span>
        </div>
        <div class="admin-image-upload-panel">
            <label for="bannerFile" class="form-label fw-semibold">Banner görseli yükle</label>
            <input id="bannerFile" name="bannerFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
            <div class="form-text">Yatay görsel önerilir. JPG, PNG veya WEBP · en fazla 5 MB.</div>
            @Html.ValidationMessage("BannerFile", null, new { @class = "text-danger small d-block mt-2" })
            @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
            {
                <div class="mt-3">
                    <p class="small text-muted mb-2">Mevcut banner</p>
                    <img src="@Url.ImageUrl(Model.BannerImageUrl)" class="campaign-banner-admin-preview" alt="Mevcut kampanya bannerı" />
                </div>
            }
        </div>
        <div class="mt-3">
            <label asp-for="BannerImageUrl" class="form-label"></label>
            <input asp-for="BannerImageUrl" class="form-control" placeholder="https://... veya /uploads/banner.jpg" />
            <span asp-validation-for="BannerImageUrl" class="text-danger"></span>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary px-4">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}