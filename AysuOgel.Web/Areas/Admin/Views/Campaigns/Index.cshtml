@model CampaignsDashboardViewModel
@{
    ViewData["Title"] = "Kampanyalar";
    var activeSection = Context.Request.Query["section"].ToString();
    var bannerExpanded = string.IsNullOrEmpty(activeSection) || activeSection == "banner";
    var campaignsExpanded = activeSection == "campaigns";
    var packagesExpanded = activeSection == "packages";
}

<div class="admin-page-heading">
    <div>
        <p class="admin-eyebrow mb-1">İÇERİK YÖNETİMİ</p>
        <h1 class="h3 mb-1">Kampanyalar</h1>
        <p class="text-muted mb-0">Kampanya bannerını ve kampanya kayıtlarını aynı ekrandan yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kampanya</a>
</div>

@if (TempData["CampaignSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["CampaignSettingsSuccess"] is string settingsSuccess)
{
    <div class="alert alert-success" role="status">@settingsSuccess</div>
}
@if (TempData["CampaignError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="accordion admin-campaigns-accordion" id="campaignsAdminAccordion">
    <div class="accordion-item admin-table-card mb-3">
        <h2 class="accordion-header" id="campaignBannerHeading">
            <button class="accordion-button @(bannerExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                    data-bs-target="#campaignBannerPanel" aria-expanded="@(bannerExpanded ? "true" : "false")" aria-controls="campaignBannerPanel">
                <span>
                    <span class="d-block fw-semibold">1. Kampanya Bannerı</span>
                    <span class="d-block small text-muted fw-normal">Kampanya sayfasının banner görseli, başlığı ve açıklaması</span>
                </span>
            </button>
        </h2>
        <div id="campaignBannerPanel" class="accordion-collapse collapse @(bannerExpanded ? "show" : "")"
             aria-labelledby="campaignBannerHeading" data-bs-parent="#campaignsAdminAccordion">
            <div class="accordion-body">
                <partial name="_BannerSettings" model="Model.PageSettings" />
            </div>
        </div>
    </div>

    <div class="accordion-item admin-table-card mb-3">
        <h2 class="accordion-header" id="campaignListHeading">
            <button class="accordion-button @(campaignsExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                    data-bs-target="#campaignListPanel" aria-expanded="@(campaignsExpanded ? "true" : "false")" aria-controls="campaignListPanel">
                <span>
                    <span class="d-block fw-semibold">2. Kampanyalar</span>
                    <span class="d-block small text-muted fw-normal">@Model.Campaigns.Count kayıt · kampanya oluşturma, düzenleme ve silme</span>
                </span>
            </button>
        </h2>
        <div id="campaignListPanel" class="accordion-collapse collapse @(campaignsExpanded ? "show" : "")"
             aria-labelledby="campaignListHeading" data-bs-parent="#campaignsAdminAccordion">
            <div class="accordion-body">
                <partial name="_CampaignList" model="Model.Campaigns" />
            </div>
        </div>
    </div>

    <div class="accordion-item admin-table-card">
        <h2 class="accordion-header" id="packageListHeading">
            <button class="accordion-button @(packagesExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                    data-bs-target="#packageListPanel" aria-expanded="@(packagesExpanded ? "true" : "false")" aria-controls="packageListPanel">
                <span>
                    <span class="d-block fw-semibold">3. Paketler</span>
                    <span class="d-block small text-muted fw-normal">@Model.Packages.Count kayıt · üyelere satılan seans paketleri</span>
                </span>
            </button>
        </h2>
        <div id="packageListPanel" class="accordion-collapse collapse @(packagesExpanded ? "show" : "")"
             aria-labelledby="packageListHeading" data-bs-parent="#campaignsAdminAccordion">
            <div class="accordion-body">
                <partial name="_PackageList" model="Model.Packages" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}