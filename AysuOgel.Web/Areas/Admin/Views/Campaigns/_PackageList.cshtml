@model List<Package>
<div class="card admin-table-card">
    <div class="card-header bg-white border-0 px-4 pt-4 d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h2 class="h5 mb-1">Paket listesi</h2>
            <p class="text-muted small mb-0">@Model.Count kayıt · üyelere satılan paketler</p>
        </div>
        <a asp-controller="Packages" asp-action="Create" class="btn btn-sm btn-primary">+ Yeni Paket</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="text-center py-5 px-3">
            <h3 class="h5">Henüz paket eklenmemiş</h3>
            <p class="text-muted">Üye kaydı yapabilmek için önce satılan paketleri ekleyin.</p>
            <a asp-controller="Packages" asp-action="Create" class="btn btn-primary">Paket ekle</a>
        </div>
    }
    else
    {
        <div class="table-responsive px-3 pb-3">
            <table class="table align-middle">
                <thead><tr><th>Paket</th><th>Seans</th><th>Fiyat</th><th>Süre</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead>
                <tbody>
                @foreach (var package in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@package.Name</div>
                            <div class="small text-muted">Sıra: @package.DisplayOrder</div>
                        </td>
                        <td class="text-nowrap">@package.SessionCount seans</td>
                        <td class="text-nowrap">@package.Price.ToLira()</td>
                        <td class="text-nowrap">@(package.ValidityDays is { } days ? $"{days} gün" : "Süresiz")</td>
                        <td>
                            @if (package.IsActive)
                            {
                                <span class="badge rounded-pill text-bg-success">Satışta</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Packages" asp-action="Edit" asp-route-id="@package.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            <form asp-controller="Packages" asp-action="Delete" asp-route-id="@package.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu paket silinsin mi?');">
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
