@model AvailabilityFormViewModel
@{
    ViewData["Title"] = "Yeni Müsaitlik Aralığı";
}

<div class="admin-page-heading">
    <div>
        <p class="admin-eyebrow mb-1">RANDEVU TAKVİMİ</p>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Bir tarih aralığı seçerek aynı saatleri birden fazla güne tek seferde ekleyin.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Müsaitlik listesine dön</a>
</div>

<div class="card admin-form-card">
    <div class="card-body p-4">
        <div class="availability-preset mb-4">
            <span class="availability-preset-icon" aria-hidden="true">✓</span>
            <div>
                <strong>Varsayılan çalışma aralığı</strong>
                <p class="mb-0">Pazartesi–Cuma, 09.00–18.00, 30 dakikalık randevular. İsterseniz aşağıdan değiştirebilirsiniz.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h5 mb-3">Tarih aralığı</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control form-control-lg" required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control form-control-lg" required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check availability-weekdays-toggle">
                        <input asp-for="WeekdaysOnly" class="form-check-input" />
                        <label asp-for="WeekdaysOnly" class="form-check-label"></label>
                        <div class="form-text">İşaretli olduğunda Cumartesi ve Pazar için aralık oluşturulmaz.</div>
                    </div>
                </div>
            </div>

            <h2 class="h5 mb-3">Günlük çalışma saatleri</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" type="time" class="form-control form-control-lg" required />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EndTime" class="form-label"></label>
                    <input asp-for="EndTime" type="time" class="form-control form-control-lg" required />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                    <div class="form-text">Son randevunun bittiği saat. 09.00–18.00 aralığında son randevu 17.30'da başlar (30 dk).</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="SlotMinutes" class="form-label"></label>
                    <select asp-for="SlotMinutes" class="form-select form-select-lg">
                        <option value="15">15 dakika</option>
                        <option value="20">20 dakika</option>
                        <option value="30">30 dakika</option>
                        <option value="45">45 dakika</option>
                        <option value="60">60 dakika</option>
                    </select>
                    <span asp-validation-for="SlotMinutes" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-light border availability-explainer">
                <strong>Çakışma kontrolü:</strong> Seçilen günlerden herhangi birinde mevcut bir saat aralığıyla çakışma varsa hiçbir yeni gün kaydedilmez. O günleri önce mevcut müsaitlik listesinden düzenleyebilirsiniz.
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-primary px-4">Seçilen günlere müsaitlik ekle</button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const start = document.getElementById('StartDate');
            const end = document.getElementById('EndDate');
            if (!start || !end) return;
            start.addEventListener('change', () => {
                end.min = start.value;
                if (end.value && end.value < start.value) end.value = start.value;
            });
            end.min = start.value;
        })();
    </script>
}