@model List<AvailabilityWindow>
@using System.Globalization
@{
    ViewData["Title"] = "Müsaitlik";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Müsaitlik Aralıkları</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Aralık</a>
</div>

<p class="text-muted">
    Yalnızca bugünden itibaren olan aralıklar gösterilir. Bir gün için birden fazla aralık ekleyebilirsiniz
    (örneğin 10:00-12:00 ve 14:00-16:30). Tanımı olmayan günler için ziyaretçi randevu alamaz.
</p>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Saat aralığı</th>
            <th>Periyot</th>
            <th>Randevu sayısı</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var w in Model)
        {
            var count = (int)((w.EndTime - w.StartTime).TotalMinutes / w.SlotMinutes);
            <tr>
                <td>@w.Date.ToString("dd.MM.yyyy dddd", tr)</td>
                <td>@w.StartTime.ToString("HH:mm") - @w.EndTime.ToString("HH:mm")</td>
                <td>@w.SlotMinutes dk</td>
                <td>@count</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@w.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@w.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu aralık silinsin mi? Bu aralıktaki mevcut randevu talepleri silinmez ama yeni saat gösterilmez.');">
                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Henüz müsaitlik aralığı eklenmemiş.</p>
}