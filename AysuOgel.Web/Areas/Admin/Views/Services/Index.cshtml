@model List<Service>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Hizmetler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Hizmet</a>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Sıra</th>
            <th>Ad</th>
            <th>Kısa Açıklama</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.DisplayOrder</td>
                <td>@s.Name</td>
                <td>@s.ShortDescription</td>
                <td>
                    @if (s.IsActive) { <span class="badge bg-success">Aktif</span> }
                    else { <span class="badge bg-secondary">Pasif</span> }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu hizmet silinsin mi?');">
                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>