@model List<Service>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="admin-page-heading">
    <div>
        <p class="admin-eyebrow mb-1">İÇERİK YÖNETİMİ</p>
        <h1 class="h3 mb-1">Hizmetler</h1>
        <p class="text-muted mb-0">Sitede gösterilen hizmetleri ve görsellerini yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3">+ Yeni Hizmet</a>
</div>

<div class="card admin-table-card">
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center px-4 pt-4">
        <div><h2 class="h5 mb-1">Hizmet listesi</h2><p class="text-muted small mb-0">@Model.Count kayıt</p></div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="text-center py-5 px-3">
            <h3 class="h5">Henüz hizmet eklenmemiş</h3>
            <p class="text-muted">İlk hizmetinizi ekleyerek başlayabilirsiniz.</p>
            <a asp-action="Create" class="btn btn-primary">Yeni hizmet ekle</a>
        </div>
    }
    else
    {
        <div class="table-responsive px-3 pb-3">
            <table class="table align-middle">
                <thead><tr><th>Sıra</th><th>Hizmet</th><th>Kısa açıklama</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><span class="admin-order-chip">@s.DisplayOrder</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(s.ImageUrl))
                                {
                                    <img src="@Url.ImageUrl(s.ImageUrl)" class="admin-table-thumb" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="admin-table-thumb admin-table-thumb-empty" aria-hidden="true">◌</span>
                                }
                                <span class="fw-semibold">@s.Name</span>
                            </div>
                        </td>
                        <td class="text-muted">@s.ShortDescription</td>
                        <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge rounded-pill text-bg-success">Aktif</span>
                                }
                            else { <span class="badge rounded-pill text-bg-secondary">Pasif</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu hizmet silinsin mi?');">
                                <button class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>