  @model List<AysuOgel.Entities.Entities.Service>
  @{
      ViewData["Title"] = "Hizmetlerimiz";
  }

  <h1 class="mb-4">@ViewData["Title"]</h1>

  <div class="row g-4">
      @foreach (var s in Model)
      {
          <div class="col-md-4">
              <div class="card h-100">
                  @if (!string.IsNullOrEmpty(s.ImageUrl))
                  {
                      <img src="@s.ImageUrl" class="card-img-top" alt="@s.Name" />
                  }
                  <div class="card-body">
                      <h5 class="card-title">@s.Name</h5>
                      <p class="card-text">@s.ShortDescription</p>
                  </div>
              </div>
          </div>
      }
  </div>