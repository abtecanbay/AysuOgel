@model ServicesPageViewModel
@{
    var c = Model.Content;
    ViewData["Title"] = c.Title;
}

<section class="page-head reveal">
    <h1 class="display-6 fw-bold section-title">@c.Title</h1>
    @if (!string.IsNullOrEmpty(c.Intro))
    {
        <p class="lead mb-0">@c.Intro</p>
    }
</section>

@if (Model.Services.Any())
{
    <section class="post-block reveal" id="post-hizmetler">
        <h2 class="h3 section-title">Neler yapıyoruz?</h2>

        <div class="card-slider" data-card-slider role="region" aria-roledescription="carousel" aria-label="Hizmetler">
            <button type="button" class="slider-arrow prev" aria-label="Önceki hizmetler">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>

            <div class="slider-track" tabindex="0">
                @foreach (var s in Model.Services)
                {
                    <div class="slider-item">
                        <a asp-controller="Services" asp-action="Details" asp-route-id="@s.Id"
                           class="card service-card h-100 text-decoration-none">
                            @if (!string.IsNullOrEmpty(s.ImageUrl))
                            {
                                <img src="@Url.ImageUrl(s.ImageUrl)" class="card-img-top media-img" alt="" loading="lazy" />
                            }
                            <div class="card-body d-flex flex-column">
                                <h3 class="h5 card-title">@s.Name</h3>
                                <p class="card-text text-muted">@s.ShortDescription</p>
                                <span class="service-more mt-auto">Detayları gör <span aria-hidden="true">→</span></span>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <button type="button" class="slider-arrow next" aria-label="Sonraki hizmetler">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
        </div>
    </section>
}

<section class="post-block reveal" id="post-kisiye-ozel-program">
    <h2 class="h3 section-title">@c.StepsTitle</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @for (var i = 0; i < c.Steps.Count; i++)
        {
            var step = c.Steps[i];
            <div class="col">
                <div class="card step-card h-100">
                    <span class="step-no" aria-hidden="true">@(i + 1)</span>
                    <h3 class="h5">@step.Title</h3>
                    <p class="text-muted mb-0">@step.Text</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="post-block reveal" id="post-fark">
    <h2 class="h3 section-title">@c.Comparison.Title</h2>
    @if (!string.IsNullOrEmpty(c.Comparison.Intro))
    {
        <p class="post-text">@c.Comparison.Intro</p>
    }
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card compare-card h-100">
                <div class="card-body">
                    <h3 class="h5 mb-3">@c.Comparison.LeftTitle</h3>
                    <ul class="compare-list">
                        @foreach (var r in c.Comparison.Rows)
                        {
                            <li><span class="compare-label">@r.Label</span>@r.Left</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card compare-card featured h-100">
                <div class="card-body">
                    <h3 class="h5 mb-3">@c.Comparison.RightTitle</h3>
                    <ul class="compare-list">
                        @foreach (var r in c.Comparison.Rows)
                        {
                            <li><span class="compare-label">@r.Label</span>@r.Right</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Successes.Any())
{
    <section class="post-block reveal" id="post-degisim">
        <h2 class="h3 section-title">@c.TransformationsTitle</h2>
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var story in Model.Successes)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="row row-cols-2 g-2">
                                <div class="col">
                                    <partial name="_BeforeAfterFrame"
                                             model="@(new BeforeAfterFrame(story.BeforeImageUrl, "Öncesi", "Üyemizin değişimi, öncesi", false))" />
                                </div>
                                <div class="col">
                                    <partial name="_BeforeAfterFrame"
                                             model="@(new BeforeAfterFrame(story.AfterImageUrl, "Sonrası", "Üyemizin değişimi, sonrası", true))" />
                                </div>
                            </div>
                            <p class="post-text mt-3 mb-0">@story.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(c.TransformationsNote))
        {
            <p class="small text-muted mt-3 mb-0">@c.TransformationsNote</p>
        }
    </section>
}

<section class="cta-band reveal mt-2">
    <h2 class="h4 mb-2">Size özel programı birlikte planlayalım</h2>
    <p class="mb-3">Formu doldurun, size dönüş yapalım.</p>
    <a class="btn btn-banner btn-lg" href="/iletisim?subject=RandevuTalebi">Randevu talep et</a>
</section>