@model AysuOgel.Entities.Entities.Member
@using AysuOgel.Entities.Entities
@{
    ViewData["Title"] = "Seanslarım";
    var now = DateTime.UtcNow.ToTurkeyTime();
    var next = Model.Packages
        .SelectMany(p => p.Sessions.Select(s => (Session: s, Package: p)))
        .Where(x => x.Session.Status == SessionStatus.Planlandi && x.Session.ScheduledAt >= now)
        .OrderBy(x => x.Session.ScheduledAt)
        .FirstOrDefault();
}

<section class="page-head reveal">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="display-6 fw-bold section-title">Merhaba, @Model.FirstName</h1>
            <p class="lead mb-0">Paketlerinizi ve seans planınızı buradan takip edebilirsiniz.</p>
        </div>
        <form asp-action="Logout" method="post" class="m-0">
            <button class="btn btn-outline-secondary btn-sm">Çıkış yap</button>
        </form>
    </div>
</section>

@if (next.Session is not null)
{
    <div class="member-next reveal mb-4" role="status">
        <span class="member-next-label">Sıradaki seansınız</span>
        <strong class="d-block fs-5">@next.Session.ScheduledAt.ToString("dd MMMM yyyy, dddd · HH:mm", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</strong>
        <span class="small">@next.Package.Package.Name · @next.Session.SessionNumber. seans</span>
    </div>
}

@if (Model.Packages.Count == 0)
{
    <div class="card"><div class="card-body p-4 text-muted">Hesabınıza tanımlı paket bulunmuyor.</div></div>
}

@foreach (var mp in Model.Packages)
{
    var sessions = mp.Sessions.OrderBy(s => s.ScheduledAt).ThenBy(s => s.CreatedAt).ToList();
    var done = sessions.Count(s => s.Status == SessionStatus.Yapildi);
    var remaining = Math.Max(0, mp.SessionCount - done);
    var percent = mp.SessionCount == 0 ? 0 : done * 100 / mp.SessionCount;

    <div class="card member-package-card mb-4 reveal">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="h4 mb-1">@mp.Package.Name</h2>
                    <p class="small text-muted mb-0">
                        Başlangıç: <strong>@mp.StartDate.ToString("dd.MM.yyyy")</strong>
                        @if (mp.EndDate.HasValue)
                        {
                            <text>&middot; Bitiş: <strong>@mp.EndDate.Value.ToString("dd.MM.yyyy")</strong></text>
                        }
                    </p>
                </div>
                <span class="chip @(mp.Status == MemberPackageStatus.Tamamlandi ? "member-chip-done" : "member-chip-active")">@mp.Status.DisplayName()</span>
            </div>

            <div class="d-flex justify-content-between small mb-1">
                <span><strong>@done / @mp.SessionCount</strong> seans tamamlandı</span>
                <span class="text-muted">@remaining seans kaldı</span>
            </div>
            <div class="progress member-progress mb-4" role="progressbar" aria-label="Tamamlanan seanslar"
                 aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @percent%"></div>
            </div>

            @if (sessions.Count == 0)
            {
                <p class="text-muted small mb-0">Henüz planlanmış seansınız yok.</p>
            }
            else
            {
                <ul class="list-unstyled member-session-list mb-0">
                    @foreach (var s in sessions)
                    {
                        var css = s.Status switch
                        {
                            SessionStatus.Yapildi => "is-done",
                            SessionStatus.IptalEdildi => "is-cancelled",
                            _ => "is-planned"
                        };
                        var cancelled = s.Status == SessionStatus.IptalEdildi;
                        <li class="member-session @css">
                            <span class="member-session-no">@(cancelled ? "–" : s.SessionNumber.ToString())</span>
                            <span class="flex-grow-1">
                                <span class="d-block fw-semibold">@(cancelled ? "İptal edilen seans" : $"{s.SessionNumber}. seans")</span>
                                <span class="small text-muted">@s.ScheduledAt.ToString("dd.MM.yyyy · HH:mm")</span>
                            </span>
                            <span class="member-session-status">@s.Status.DisplayName()</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

<p class="small text-muted">
    Seans tarihinizi değiştirmek için
    <a asp-controller="Contact" asp-action="Index" asp-route-subject="@ContactSubject.SeansDegisikligi">seans saati değişikliği talebi gönderin</a>.
</p>
