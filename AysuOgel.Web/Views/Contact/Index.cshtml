@model ContactFormViewModel
@using AysuOgel.Entities.Entities
@using AysuOgel.Business.Abstract
@inject IAppointmentSlotService Slots

@{
    ViewData["Title"] = "İletişim";
    const string MapPlace = "Arma Kule";
    const string MapAddress = "Kızılırmak, 2121. Sk. No:5, 06510 Çankaya/Ankara";
    var mapQuery = Uri.EscapeDataString($"{MapPlace}, {MapAddress}");

    // "Seans saati değişikliği" yalnızca seans sorgulama girişi yapmış üyelere gösterilir.
    var signedInMember = ViewData["SignedInMember"] as Member;
    var memberOnlySubject = ((int)ContactSubject.SeansDegisikligi).ToString();
    var subjectItems = Html.GetEnumSelectList<ContactSubject>()
        .Where(i => signedInMember is not null || i.Value != memberOnlySubject)
        .ToList();
}

<section class="page-head reveal">
    <h1 class="display-6 fw-bold section-title">İletişim ve Randevu</h1>
    <p class="lead mb-0">Bilgi almak ya da randevu talep etmek için formu doldurun, size dönüş yapalım.</p>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-5 reveal">
        <div class="card h-100 contact-card">
            <div class="card-body">
                <h2 class="h5 mb-3">Bize ulaşın</h2>
                <ul class="contact-info list-unstyled mb-4">
                    <li>
                        <span class="compare-label">Adres</span>
                        <address class="mb-0">
                            <strong>@MapPlace</strong><br />
                            @MapAddress
                        </address>
                    </li>
                    <li>
                        <span class="compare-label">Telefon</span>
                        <a class="contact-whatsapp" href="https://wa.me/905551007704" target="_blank" rel="noopener"
                           aria-label="WhatsApp üzerinden mesaj gönderin: +90 555 100 77 04">
                            <svg class="contact-whatsapp-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.45 9.45 0 0 1-4.82-1.32l-.35-.2-3.58.94.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47 2.53 0 4.91.99 6.7 2.78a9.41 9.41 0 0 1 2.77 6.7c0 5.22-4.25 9.46-9.47 9.46zm8.06-17.53A11.33 11.33 0 0 0 12.04.63C5.76.63.65 5.74.65 12.02c0 2 .52 3.96 1.52 5.69L.55 23.6l6.03-1.58a11.36 11.36 0 0 0 5.45 1.39h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.19-5.9-3.33-8.05z" />
                            </svg>
                            +90 555 100 77 04
                        </a>
                    </li>
                    <li><span class="compare-label">Çalışma saatleri</span>Hafta içi 09.30 – 19.00 <small class="text-muted">(resmi tatiller ve bayramlarda değişkenlik gösterebilir)</small></li>
                </ul>
                <div class="contact-map shadow-sm">
                    <iframe src="https://maps.google.com/maps?q=@mapQuery&z=17&hl=tr&output=embed"
                            title="@MapPlace konumu - Google Haritalar" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @* Başlangıç noktası verilmez; Google Haritalar ziyaretçinin konumundan (ya da yazdığı yerden) Arma Kule'ye yol tarifi açar. *@
                    <a class="btn btn-banner" href="https://www.google.com/maps/dir/?api=1&destination=@mapQuery"
                       target="_blank" rel="noopener">Yol tarifi al</a>
                    <a class="btn btn-outline-secondary" href="https://www.google.com/maps/search/?api=1&query=@mapQuery"
                       target="_blank" rel="noopener">Google Haritalar'da aç</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7 reveal">
        <div class="card h-100">
            <div class="card-body p-4">
                @if (TempData["ContactSuccess"] is string success)
                {
                    <div class="alert alert-success" role="status">@success</div>
                }

                @if (signedInMember is not null)
                {
                    <div class="alert alert-info small" role="status">
                        <strong>@signedInMember.FirstName @signedInMember.LastName</strong> olarak giriş yaptınız; bilgileriniz forma eklendi.
                        Seans saatinizi değiştirmek için konu olarak <strong>Seans saati değişikliği</strong> seçip uygun olduğunuz gün ve saatleri yazabilirsiniz.
                    </div>
                }

                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" placeholder="05xx xxx xx xx" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label"></label>
                            <select asp-for="Subject" asp-items="subjectItems" class="form-select">
                                <option value="">Konu seçin</option>
                            </select>
                            <span asp-validation-for="Subject" class="text-danger"></span>

                            <div class="col-12">
                                @{
                                    var calendarOpen = string.IsNullOrEmpty(Model.AppointmentSlot);
                                }
                                <div class="collapse @(Model.Subject == ContactSubject.RandevuTalebi ? "show" : "")" id="apptPanel"
                                     data-appt-value="@((int)ContactSubject.RandevuTalebi)"
                                     data-min="@Slots.MinDate.ToString("yyyy-MM-dd")"
                                     data-max="@Slots.MaxDate.ToString("yyyy-MM-dd")"
                                     data-closed="@string.Join(",", Slots.ClosedWeekdays)"
                                     data-slots-url="@Url.Action("Slots", "Contact")">
                                    <div class="appt-box">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <span class="form-label d-block">Randevu tarihi</span>
                                                <button type="button" id="apptDateBtn" class="appt-field @(calendarOpen ? "" : "collapsed")"
                                                        data-bs-toggle="collapse" data-bs-target="#apptCalendar"
                                                        aria-expanded="@(calendarOpen ? "true" : "false")" aria-controls="apptCalendar">
                                                    <span id="apptDateText" class="placeholder-text">Tarih seçin</span>
                                                </button>
                                            </div>
                                            <div class="col-md-6">
                                                <span class="form-label d-block">Randevu saati</span>
                                                <div class="dropdown">
                                                    <button type="button" id="apptTimeBtn" class="appt-field" data-bs-toggle="dropdown"
                                                            aria-expanded="false" disabled>
                                                        <span id="apptTimeText" class="placeholder-text">Önce tarih seçin</span>
                                                    </button>
                                                    <ul class="dropdown-menu appt-menu" id="apptTimeMenu"></ul>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="collapse @(calendarOpen ? "show" : "")" id="apptCalendar">
                                                    <div class="calendar" id="calendar"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <input asp-for="AppointmentSlot" type="hidden" />
                                        <span asp-validation-for="AppointmentSlot" class="text-danger d-block mt-2"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="5" maxlength="2000"></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div class="hp" aria-hidden="true">
                            <label asp-for="Website">Web sitesi</label>
                            <input asp-for="Website" tabindex="-1" autocomplete="off" />
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="KvkkAccepted" class="form-check-input" />
                                <label asp-for="KvkkAccepted" class="form-check-label">
                                    <a href="/kvkk-aydinlatma" target="_blank" rel="noopener noreferrer">KVKK Aydınlatma Metni</a>'ni okudum ve bilgilendirildim.
                                </label>
                                <span asp-validation-for="KvkkAccepted" class="text-danger d-block"></span>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-brand btn-lg">Gönder</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment.js" asp-append-version="true"></script>
}