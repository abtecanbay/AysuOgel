@model HomeViewModel
@{
    ViewData["Title"] = "Anasayfa";
}

<partial name="_BannerSlider" model="Model.Content.Banners" />

@foreach (var block in Model.Content.Blocks)
{
    <partial name="_ContentBlock" model="block" />
}

@if (Model.Services.Any())
{
    <section class="post-block reveal">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h2 class="h3 section-title mb-0">Hizmetlerimiz</h2>
            <a href="/hizmetler" class="fw-bold">Tümünü gör</a>
        </div>
        <div class="row row-cols-2 row-cols-lg-4 g-3">
            @foreach (var s in Model.Services)
            {
                <div class="col">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(s.ImageUrl))
                        {
                            <img src="@Url.ImageUrl(s.ImageUrl)" class="card-img-top media-img" alt="@s.Name" loading="lazy" />
                        }
                        <div class="card-body">
                            <h3 class="h6 card-title">@s.Name</h3>
                            <p class="card-text small text-muted">@s.ShortDescription</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}